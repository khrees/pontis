# ==============================================================================
# Pontis Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Bindings
# ------------------------------------------------------------------------------
# Port for the local proxy HTTP / WebSocket server (default: 8787)
PONTIS_PORT=8787

# Host address to bind to (default: 127.0.0.1)
PONTIS_HOST=127.0.0.1

# TLS port for optional Codex redirected traffic (default: 8443)
PONTIS_REDIRECT_PORT=8443

# ------------------------------------------------------------------------------
# 2. Provider Selection & Upstream Settings
# ------------------------------------------------------------------------------
# Active provider: opencode | cloudflare | local (default: opencode)
PONTIS_PROVIDER=opencode

# Default model ID to remap to or launch with
# OpenCode examples: mimo-v2.5-free, deepseek-v4-flash-free, big-pickle, qwen3.6-plus
# Cloudflare examples: @cf/moonshotai/kimi-k2.6, @cf/zai-org/glm-5.2, @cf/qwen/qwen2.5-coder-32b-instruct
PONTIS_MODEL=mimo-v2.5-free

# Custom upstream base URL (overrides default provider endpoints)
# Example for local Ollama: http://localhost:11434/v1
# Example for LM Studio:    http://localhost:1234/v1
# PONTIS_UPSTREAM_URL=http://localhost:11434/v1

# Upstream API protocol format: openai | anthropic | openai-completions (default: openai)
PONTIS_UPSTREAM_FORMAT=openai

# OpenCode upstream endpoints (defaults to production endpoints)
# PONTIS_ZEN_UPSTREAM=https://opencode.ai/zen/v1
# PONTIS_GO_UPSTREAM=https://opencode.ai/zen/go/v1

# Fallback vision model for multimodal requests (default: qwen3.6-plus)
# PONTIS_VISION_MODEL=qwen3.6-plus

# ------------------------------------------------------------------------------
# 3. Authentication & API Keys
# ------------------------------------------------------------------------------
# OpenCode API Key (get from https://opencode.ai/auth -> Zen -> API Keys)
# OPENCODE_API_KEY=sk-...

# Cloudflare Workers AI / AI Gateway Credentials
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...
# CLOUDFLARE_GATEWAY_ID=default

# Local engine API key (if required by local proxy/server)
# LOCAL_API_KEY=sk-local...

# Minimum API key length validation (default: 32, set 0 to disable)
# PONTIS_MIN_KEY_LENGTH=32

# ------------------------------------------------------------------------------
# 4. Performance, Buffers & Timeouts
# ------------------------------------------------------------------------------
# Upstream request timeout in milliseconds (default: 120000 -> 2 minutes)
PONTIS_TIMEOUT_MS=120000

# Maximum SSE stream buffer size in megabytes (default: 5MB)
# PONTIS_MAX_BUFFER_MB=5

# SSE stream chunk processing size in kilobytes (default: 64KB)
# PONTIS_CHUNK_SIZE_KB=64

# Responses API turn cache size limit (default: 50 turns)
# PONTIS_CACHE_MAX_TURNS=50

# Responses API turn cache TTL in milliseconds (default: 300000 -> 5 minutes)
# PONTIS_CACHE_TTL_MS=300000

# ------------------------------------------------------------------------------
# 5. Diagnostics & Debugging
# ------------------------------------------------------------------------------
# Enable verbose request/response logging and payloads to console and proxy.log
PONTIS_DEBUG=false

# Force Codex-format model metadata in /v1/models (default: false)
# PONTIS_CODEX_MODE=false
