{
  "name": "pontis",
  "version": "1.1.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "bun run build:proxy && bun run build:cli",
    "build:proxy": "esbuild src/local-server.ts --bundle --platform=node --target=node18 --outfile=dist/proxy.js",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=dist/cli.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260504.1",
    "@types/node": "^25.9.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "pkg": "^5.8.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.87.0"
  },
  "license": "MIT",
  "description": "Universal AI gateway and runtime launcher bridging Claude Code, Codex CLI, OpenCode, Pi, Cloudflare Workers AI, and local LLMs with bidirectional protocol translation (Anthropic, OpenAI Chat, Responses API, and Completions).",
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "hono": "^4.12.17"
  }
}
